# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
# With NO .env.local present the app runs in mock mode (in-memory seed data).

# Google Maps JavaScript API key (server reference / build-time).
# Create in Google Cloud Console; stay within the free tier and set a hard quota cap.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Maps key exposed to the browser for the client-side map.
# TRADEOFF: any NEXT_PUBLIC_* value ships to the client and is visible in the bundle.
# This is acceptable ONLY for an HTTP-referrer-restricted Maps key with a quota cap,
# so a leaked key cannot be used from other origins. Do NOT expose unrestricted keys.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-referrer-restricted-google-maps-api-key

# Supabase project URL (safe to expose; it is a public endpoint).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose with Row Level Security enabled).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key (SERVER ONLY — bypasses RLS). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Shared password that unlocks editor mode (SERVER ONLY).
# POST /api/editor/unlock compares against this and sets an httpOnly cookie.
EDITOR_PASSWORD=choose-a-strong-shared-password
